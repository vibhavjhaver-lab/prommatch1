{
  "name": "prommatch",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev:all": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @prommatch/web dev",
    "dev:worker": "pnpm --filter @prommatch/worker dev",
    "dev:realtime": "pnpm --filter @prommatch/realtime dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "check": "turbo run lint typecheck test build",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "restore:check": "tsx scripts/restore-check.ts",
    "db:migrate": "pnpm --filter @prommatch/db exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @prommatch/db exec prisma migrate dev",
    "db:studio": "pnpm --filter @prommatch/db exec prisma studio",
    "db:generate": "pnpm --filter @prommatch/db exec prisma generate",
    "generate:secrets": "tsx scripts/generate-secrets.ts"
  },
  "dependencies": {
    "@prommatch/config": "workspace:*",
    "@prommatch/core": "workspace:*",
    "@prommatch/db": "workspace:*",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "prettier": "^3.3.0",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.5"
  }
}
