# Copy to .env and fill in. `pnpm setup` does the copy for you.
# Shared across apps/web, apps/worker, and apps/realtime unless noted —
# in production, set each service's own copy of this file (or its
# platform's equivalent env var UI); locally, one .env at the repo root
# covers all three since they all read from the same shell environment
# when run via `pnpm dev:all`.

NODE_ENV=development

# ---------- Database & queue ----------
# Local: docker compose -f infra/docker-compose.yml up -d, then this.
DATABASE_URL="postgresql://prommatch:prommatch@localhost:5432/prommatch"
REDIS_URL="redis://localhost:6379"

# ---------- Secrets (generate with `pnpm generate:secrets`) ----------
# AUTH_SECRET: apps/web only — Auth.js session encryption.
AUTH_SECRET=""
# REALTIME_JWT_SECRET: apps/web AND apps/realtime — must be identical on both.
REALTIME_JWT_SECRET=""
# CRON_SECRET: apps/web only — shared secret your cron pinger sends as x-cron-secret.
CRON_SECRET=""
# FIELD_ENCRYPTION_KEY: apps/web only — AES-256-GCM key for encrypted Prisma fields
# (see DECISIONS.md — currently used for genderSelf; gender itself is not
# field-encrypted, also explained there).
FIELD_ENCRYPTION_KEY=""
# EMAIL_HASH_SALT: apps/web AND apps/worker — must be identical on both
# (hashing excludedEmails, recovery codes, etc. the same way on each side).
EMAIL_HASH_SALT=""

# ---------- Web push (VAPID) ----------
# Generate with: pnpm --filter @prommatch/worker exec node -e "console.log(require('web-push').generateVAPIDKeys())"
# Needed by apps/web (to hand the public key to the browser) and apps/worker (to actually send).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# apps/worker only — the mailto: contact VAPID requires.
VAPID_CONTACT_EMAIL="organizer@college.edu"

# ---------- Object storage (S3-compatible) ----------
# Local: MinIO via docker-compose, defaults below match infra/docker-compose.yml.
# Production: any S3-compatible provider (Cloudflare R2, AWS S3, Backblaze B2, ...).
# Needed by apps/web (presigned uploads) and apps/worker (data exports).
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="prommatch"
S3_ACCESS_KEY="prommatch"
S3_SECRET_KEY="prommatch123"

# ---------- Email (SMTP) ----------
# Local: run a catch-all like MailHog/Mailpit and point SMTP_URL at it so
# you're not sending real email in dev. Needed by apps/web (sign-in codes)
# and apps/worker (notifications, digests, exports).
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="PromMatch <no-reply@college.edu>"

# ---------- URLs ----------
# apps/web only — its own public origin, used to build links in emails/notifications.
APP_URL="http://localhost:3000"
# apps/web only — where the browser connects for live chat (apps/realtime's public origin).
REALTIME_URL="http://localhost:4000"

# ---------- apps/realtime only ----------
REALTIME_PORT="4000"
# Comma-separated list of origins allowed to open a socket (APP_URL, usually just one entry).
REALTIME_CORS_ORIGINS="http://localhost:3000"

# ---------- Optional ----------
SENTRY_DSN=""
OPENAI_MODERATION_KEY=""

# ---------- Ops scripts only (not read by the apps themselves) ----------
# scripts/restore-check.ts — a throwaway database, never one anything depends on.
RESTORE_CHECK_DATABASE_URL=""
